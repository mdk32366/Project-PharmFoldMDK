{"entryType": "UniProtKB reviewed (Swiss-Prot)", "primaryAccession": "Q86V24", "secondaryAccessions": ["Q53YY5", "Q9H737"], "uniProtkbId": "PAQR2_HUMAN", "entryAudit": {"firstPublicDate": "2003-11-14", "lastAnnotationUpdateDate": "2026-06-10", "lastSequenceUpdateDate": "2003-06-01", "entryVersion": 166, "sequenceVersion": 1}, "annotationScore": 5.0, "organism": {"scientificName": "Homo sapiens", "commonName": "Human", "taxonId": 9606, "lineage": ["Eukaryota", "Metazoa", "Chordata", "Craniata", "Vertebrata", "Euteleostomi", "Mammalia", "Eutheria", "Euarchontoglires", "Primates", "Haplorrhini", "Catarrhini", "Hominidae", "Homo"]}, "proteinExistence": "1: Evidence at protein level", "proteinDescription": {"recommendedName": {"fullName": {"evidences": [{"evidenceCode": "ECO:0000303", "source": "PubMed", "id": "25969726"}], "value": "Adiponectin receptor protein 2"}}, "alternativeNames": [{"fullName": {"evidences": [{"evidenceCode": "ECO:0000303", "source": "PubMed", "id": "16044242"}], "value": "Progestin and adipoQ receptor family member 2"}}, {"fullName": {"value": "Progestin and adipoQ receptor family member II"}}]}, "genes": [{"geneName": {"evidences": [{"evidenceCode": "ECO:0000312", "source": "HGNC", "id": "HGNC:24041"}], "value": "ADIPOR2"}, "synonyms": [{"evidences": [{"evidenceCode": "ECO:0000303", "source": "PubMed", "id": "16044242"}], "value": "PAQR2"}]}], "comments": [{"texts": [{"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "Q8BQS5"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "12802337"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "25855295"}], "value": "Receptor for ADIPOQ, an essential hormone secreted by adipocytes that regulates glucose and lipid metabolism (PubMed:12802337, PubMed:25855295). Required for normal body fat and glucose homeostasis. ADIPOQ-binding activates a signaling cascade that leads to increased PPARA activity, and ultimately to increased fatty acid oxidation and glucose uptake. Has intermediate affinity for globular and full-length adiponectin. Required for normal revascularization after chronic ischemia caused by severing of blood vessels (By similarity)"}], "commentType": "FUNCTION"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "Q8BQS5"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "12802337"}], "value": "May form homooligomers and heterooligomers with ADIPOR1 (PubMed:12802337). Interacts with APPL2 (via BAR domain); ADIPOQ dissociates this interaction (By similarity)"}], "commentType": "SUBUNIT"}, {"commentType": "INTERACTION", "interactions": [{"interactantOne": {"uniProtKBAccession": "Q86V24", "intActId": "EBI-1769445"}, "interactantTwo": {"uniProtKBAccession": "P55061", "geneName": "TMBIM6", "intActId": "EBI-1045825"}, "numberOfExperiments": 3, "organismDiffer": false}]}, {"commentType": "SUBCELLULAR LOCATION", "note": {"texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "12802337"}], "value": "Localized to the cell membrane and intracellular organelles"}]}, "subcellularLocations": [{"location": {"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "12802337"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "25855295"}], "value": "Cell membrane", "id": "SL-0039"}, "topology": {"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "12802337"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "25855295"}], "value": "Multi-pass membrane protein", "id": "SL-9909"}}]}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "12802337"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "16044242"}], "value": "Ubiquitous (PubMed:16044242). Highly expressed in skeletal muscle, liver and placenta (PubMed:12802337). Weakly expressed in brain, heart, colon, spleen, kidney, thymus, small intestine, peripheral blood leukocytes and lung (PubMed:12802337)"}], "commentType": "TISSUE SPECIFICITY"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "12802337"}], "value": "The N-terminus is cytoplasmic and the C-terminus is extracellular, contrary to what is observed for G protein-coupled receptors. Unlike G protein-coupled receptors, transmembrane helices are not kinked or tilted relative to the plane of the membrane"}], "commentType": "DOMAIN"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000305"}], "value": "Belongs to the ADIPOR family"}], "commentType": "SIMILARITY"}, {"commentType": "SEQUENCE CAUTION", "sequenceCautionType": "Erroneous initiation", "sequence": "BAB15062.1", "note": "Truncated N-terminus.", "evidences": [{"evidenceCode": "ECO:0000305"}]}, {"commentType": "WEB RESOURCE", "resourceName": "Wikipedia", "resourceUrl": "https://en.wikipedia.org/wiki/Adiponectin", "ftp": false, "note": "Adiponectin entry"}], "features": [{"type": "Chain", "location": {"start": {"value": 1, "modifier": "EXACT"}, "end": {"value": 386, "modifier": "EXACT"}}, "description": "Adiponectin receptor protein 2", "featureId": "PRO_0000218829"}, {"type": "Topological domain", "location": {"start": {"value": 1, "modifier": "EXACT"}, "end": {"value": 147, "modifier": "EXACT"}}, "description": "Cytoplasmic", "evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "25855295"}]}, {"type": "Transmembrane", "location": {"start": {"value": 148, "modifier": "EXACT"}, "end": {"value": 168, "modifier": "EXACT"}}, "description": "Helical; Name=1", "evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "25855295"}]}, {"type": "Topological domain", "location": {"start": {"value": 169, "modifier": "EXACT"}, "end": {"value": 181, "modifier": "EXACT"}}, "description": "Extracellular", "evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "25855295"}]}, {"type": "Transmembrane", "location": {"start": {"value": 182, "modifier": "EXACT"}, "end": {"value": 202, "modifier": "E