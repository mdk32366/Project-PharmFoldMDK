 luminal membranes of crypts in ascending colon (By similarity)"}]}, "subcellularLocations": [{"location": {"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "18948439"}], "value": "Cell membrane", "id": "SL-0039"}, "topology": {"evidences": [{"evidenceCode": "ECO:0000255"}], "value": "Multi-pass membrane protein", "id": "SL-9909"}}, {"location": {"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "22622463"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "34292591"}, {"evidenceCode": "ECO:0000305", "source": "PubMed", "id": "28042826"}], "value": "Mitochondrion inner membrane", "id": "SL-0168"}, "topology": {"evidences": [{"evidenceCode": "ECO:0000255"}], "value": "Multi-pass membrane protein", "id": "SL-9909"}}, {"location": {"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "P56404"}, {"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "P56405"}], "value": "Apical cell membrane", "id": "SL-0015"}, "topology": {"evidences": [{"evidenceCode": "ECO:0000255"}], "value": "Multi-pass membrane protein", "id": "SL-9909"}}, {"location": {"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "P56405"}], "value": "Basolateral cell membrane", "id": "SL-0026"}, "topology": {"evidences": [{"evidenceCode": "ECO:0000255"}], "value": "Multi-pass membrane protein", "id": "SL-9909"}}, {"location": {"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "P56404"}], "value": "Smooth endoplasmic reticulum membrane", "id": "SL-0250"}, "topology": {"evidences": [{"evidenceCode": "ECO:0000255"}], "value": "Multi-pass membrane protein", "id": "SL-9909"}}]}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "28042826"}], "value": "Detected in the sperm midpiece (at protein level) (PubMed:28042826). Expressed only in pancreas and colon"}], "commentType": "TISSUE SPECIFICITY"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:00002