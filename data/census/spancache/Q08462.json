{"entryType": "UniProtKB reviewed (Swiss-Prot)", "primaryAccession": "Q08462", "secondaryAccessions": ["B7Z2C1", "Q2NKL8", "Q9UDB2", "Q9UPU2"], "uniProtkbId": "ADCY2_HUMAN", "entryAudit": {"firstPublicDate": "1994-10-01", "lastAnnotationUpdateDate": "2026-06-10", "lastSequenceUpdateDate": "2006-11-28", "entryVersion": 211, "sequenceVersion": 5}, "annotationScore": 5.0, "organism": {"scientificName": "Homo sapiens", "commonName": "Human", "taxonId": 9606, "lineage": ["Eukaryota", "Metazoa", "Chordata", "Craniata", "Vertebrata", "Euteleostomi", "Mammalia", "Eutheria", "Euarchontoglires", "Primates", "Haplorrhini", "Catarrhini", "Hominidae", "Homo"]}, "proteinExistence": "1: Evidence at protein level", "proteinDescription": {"recommendedName": {"fullName": {"value": "Adenylate cyclase type 2"}, "ecNumbers": [{"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15385642"}], "value": "4.6.1.1"}]}, "alternativeNames": [{"fullName": {"value": "ATP pyrophosphate-lyase 2"}}, {"fullName": {"value": "Adenylate cyclase type II"}}, {"fullName": {"value": "Adenylyl cyclase 2"}}]}, "genes": [{"geneName": {"value": "ADCY2"}, "synonyms": [{"value": "KIAA1060"}]}], "comments": [{"texts": [{"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "P26769"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15385642"}], "value": "Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling (PubMed:15385642). Down-stream signaling cascades mediate changes in gene expression patterns and lead to increased IL6 production. Functions in signaling cascades downstream of the muscarinic acetylcholine receptors (By similarity)"}], "commentType": "FUNCTION"}, {"commentType": "CATALYTIC ACTIVITY", "reaction": {"name": "ATP = 3',5'-cyclic AMP + diphosphate", "reactionCrossReferences": [{"database": "Rhea", "id": "RHEA:15389"}, {"database": "ChEBI", "id": "CHEBI:30616"}, {"database": "ChEBI", "id": "CHEBI:33019"}, {"database": "ChEBI", "id": "CHEBI:58165"}], "ecNumber": "4.6.1.1", "evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15385642"}]}}, {"commentType": "COFACTOR", "cofactors": [{"name": "Mg(2+)", "evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15385642"}], "cofactorCrossReference": {"database": "ChEBI", "id": "CHEBI:18420"}}, {"name": "Mn(2+)", "evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15385642"}], "cofactorCrossReference": {"database": "ChEBI", "id": "CHEBI:29035"}}], "note": {"texts": [{"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "P26769"}], "value": "Binds 2 magnesium ions per subunit. Is also active with manganese (in vitro)."}]}}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "P26769"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15385642"}], "value": "Activated by forskolin (PubMed:15385642). Is not activated by calmodulin. Inhibited by calcium ions, already at micromolar concentration. Activated by the G protein alpha subunit GNAS. Activated by the G protein beta and gamma subunit complex (By similarity). Phosphorylation by RAF1 results in its activation (PubMed:15385642). Phosphorylation by PKC activates the enzyme (By similarity)"}], "commentType": "ACTIVITY REGULATION"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000250", "source": "UniProtKB", "id": "P26769"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15385642"}], "value": "Interacts with RAF1 (PubMed:15385642). Interacts with GNAS. Interacts with the G protein beta and gamma subunit complex (By similarity)"}], "commentType": "SUBUNIT"}, {"commentType": "SUBCELLULAR LOCATION", "subcellularLocations": [{"location": {"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15385642"}], "value": "Membrane", "id": "SL-0162"}, "topology": {"evidences": [{"evidenceCode": "ECO:0000305"}], "value": "Multi-pass membrane pr