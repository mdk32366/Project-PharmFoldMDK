{"entryType": "UniProtKB reviewed (Swiss-Prot)", "primaryAccession": "Q99467", "secondaryAccessions": ["B2R7Z7", "Q32MM5"], "uniProtkbId": "CD180_HUMAN", "entryAudit": {"firstPublicDate": "2002-03-27", "lastAnnotationUpdateDate": "2026-06-10", "lastSequenceUpdateDate": "2010-05-18", "entryVersion": 192, "sequenceVersion": 2}, "annotationScore": 5.0, "organism": {"scientificName": "Homo sapiens", "commonName": "Human", "taxonId": 9606, "lineage": ["Eukaryota", "Metazoa", "Chordata", "Craniata", "Vertebrata", "Euteleostomi", "Mammalia", "Eutheria", "Euarchontoglires", "Primates", "Haplorrhini", "Catarrhini", "Hominidae", "Homo"]}, "proteinExistence": "1: Evidence at protein level", "proteinDescription": {"recommendedName": {"fullName": {"value": "CD180 antigen"}}, "alternativeNames": [{"fullName": {"value": "Lymphocyte antigen 64"}}, {"fullName": {"value": "Radioprotective 105 kDa protein"}}], "cdAntigenNames": [{"value": "CD180"}], "flag": "Precursor"}, "genes": [{"geneName": {"value": "CD180"}, "synonyms": [{"value": "LY64"}, {"value": "RP105"}]}], "comments": [{"texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15852007"}], "value": "Pattern recognition receptor predominantly expressed on B-cells, dendritic cells, and certain monocytes/macrophages, structurally resembling Toll-like receptors (TLRs) that plays a role in modulating immune responses (PubMed:15852007). While ressembling a TLR, lacks the intracellular TIR (Toll/IL-1R) signaling domain and thus does not directly transduce signals. Instead, modulates immune responses, often in conjunction with other TLRs. For example, in cooperation with MD-1/LY86, interacts directly with the TLR4 signaling complex, inhibiting its ability to bind microbial ligand (PubMed:15852007)"}], "commentType": "FUNCTION"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15852007"}, {"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "21959264"}], "value": "M-shaped tetramer of two CD180-LY86 heterodimers (PubMed:21959264). Interacts with TLR4, this interaction inhibits TLR4-mediated signaling pathway upon ligand binding (PubMed:15852007)"}], "commentType": "SUBUNIT"}, {"commentType": "INTERACTION", "interactions": [{"interactantOne": {"uniProtKBAccession": "Q99467", "intActId": "EBI-15940363"}, "interactantTwo": {"uniProtKBAccession": "O95711", "geneName": "LY86", "intActId": "EBI-12203791"}, "numberOfExperiments": 3, "organismDiffer": false}]}, {"commentType": "SUBCELLULAR LOCATION", "subcellularLocations": [{"location": {"value": "Cell membrane", "id": "SL-0039"}, "topology": {"value": "Single-pass type I membrane protein", "id": "SL-9905"}}]}, {"texts": [{"value": "Expressed mainly on mature peripherical B cells. Detected in spleen, lymph node and appendix. Not detected in pre-B and -T cells"}], "commentType": "TISSUE SPECIFICITY"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000305"}], "value": "Belongs to the Toll-like receptor family"}], "commentType": "SIMILARITY"}], "features": [{"type": "Signal", "location": {"start": {"value": 1, "modifier": "EXACT"}, "end": {"value": 23, "modifier": "EXACT"}}, "description": "", "evidences": [{"evidenceCode": "ECO:0000269", "source": "PubMed", "id": "15340161"}]}, {"type": "Chain", "location": {"start": {"value": 24, "modifier": "EXACT"}, "end": {"value": 661, "modifier": "EXACT"}}, "description": "CD180 antigen", "featureId": "PRO_0000034741"}, {"type": "Topological domain", "location": {"start": {"value": 24, "modifier": "EXACT"}, "end": {"value": 626, "modifier": "EXACT"}}, "description": "Extracellular", "evidences": [{"evidenceCode": "ECO:0000255"}]}, {"type": "Transmembrane", "location": {"start": {"value": 627, "modifier": "EXACT"}, "end": {"value": 650, "modifier": "EXACT"}}, "description": "Helical", "evidences": [{"evidenceCode": "ECO:0000255"}]}, {"type": "Topological domain", "location": {"start": {"value": 651, "modifier": "EXACT"}, "end": {"value": 661, "m